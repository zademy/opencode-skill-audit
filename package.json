{
  "name": "opencode-skill-audit-tui",
  "version": "0.4.1",
  "description": "OpenCode v2 TUI plugin: context occupancy and loaded-skill accounting in the footer",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zademy/opencode-skill-audit.git"
  },
  "main": "./dist/tui.js",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "build:check": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node src/calc.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build:check && npm run test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@opentui/core": "0.6.0",
    "@opentui/solid": "0.6.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
